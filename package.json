{
  "name": "horizon",
  "version": "1.12.1",
  "description": "Horizon: a clean Android AI chat app (Gemini, Groq, Cohere or free Pollinations, image mode, web tools, YouTube music downloads, GitHub vault, music player) built with Capacitor.",
  "private": true,
  "license": "MIT",
  "author": "Grant 'Fezzy' Festers (philfesters)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/philfesters/horizon.git"
  },
  "scripts": {
    "add:android": "cap add android",
    "sync": "cap sync android",
    "open:android": "cap open android",
    "icons": "python3 scripts/make_icons.py",
    "capacitor:sync:after": "bash scripts/apply-android.sh",
    "capacitor:update:after": "bash scripts/apply-android.sh"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^5.0.0",
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/local-notifications": "^6.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0"
  }
}
