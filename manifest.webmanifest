{
  "name": "Ember",
  "short_name": "Ember",
  "description": "Ember companion with keyless routing, local document export and public-source reading.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#000000",
  "theme_color": "#000000",
  "icons": [
    {
      "src": "ember-icon.svg",
      "sizes": "any",
